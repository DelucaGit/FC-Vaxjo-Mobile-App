# Copy to .env and fill in your own values.
# NEVER commit the real .env file.

# PostgreSQL
POSTGRES_DB=fcvaxjo
POSTGRES_USER=fcvaxjo
POSTGRES_PASSWORD=replace-with-a-long-random-db-password

# API database connection (inside Docker network, host is "db")
DB_URL=jdbc:postgresql://db:5432/fcvaxjo
DB_USER=fcvaxjo
DB_PASSWORD=replace-with-a-long-random-db-password

# JWT signing secret — at least 32 characters, random
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# First admin account (only created when ADMIN_SEED=true)
ADMIN_SEED=true
ADMIN_EMAIL=admin@fcvaxjo.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FIRST_NAME=Club
ADMIN_LAST_NAME=Admin

# Browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Mobile web app talks to the API through the host-mapped port
EXPO_PUBLIC_API_URL=http://localhost:8080
