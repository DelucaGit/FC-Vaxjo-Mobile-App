    <diagram id="v1-prototype" name="Version 1 prototype">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;font color=&quot;#ffffff&quot;&gt;Version 1 — how the data looks (example rows)&lt;/font&gt;" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1A202C;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="720" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="sub" value="&lt;font color=&quot;#e6e6e6&quot;&gt;Made-up club data. Permissions are not rows yet — they are ifs in UserService.&lt;/font&gt;" style="text;html=1;fontSize=12;fontColor=#1A202C;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="44" width="720" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="users-box" value="users" style="swimlane;fontStyle=1;startSize=28;collapsible=0;fillColor=#2B6CB0;fontColor=#FFFFFF;strokeColor=#2C5282;swimlaneFillColor=#FFFFFF;fontSize=14;" parent="1" vertex="1">
