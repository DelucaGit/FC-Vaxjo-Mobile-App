                </mxCell>
                <mxCell id="p2-http-body" value="POST /users&lt;br&gt;create user with a role&lt;br&gt;&lt;br&gt;PUT /users/{id}/role&lt;br&gt;replace the role&lt;br&gt;&lt;br&gt;GET /users/{id}" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=12;fontColor=#1A202C;fontFamily=Courier New;" parent="p2-http" vertex="1">
                    <mxGeometry y="32" width="320" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="p2-access" value="Who may create / change" style="swimlane;collapsible=0;fontStyle=1;startSize=32;fillColor=#EDF2F7;swimlaneFillColor=#FFFFFF;strokeColor=#4A5568;fontColor=#1A202C;fontSize=13;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="460" y="380" width="380" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p2-access-body" value="ADMIN → ADMIN, COACH, PLAYER, PARENT&lt;br&gt;COACH → PLAYER, PARENT&lt;br&gt;PLAYER / PARENT → none&lt;br&gt;&lt;br&gt;First ADMIN is seed data." style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=12;fontColor=#1A202C;" parent="p2-access" vertex="1">
                    <mxGeometry y="32" width="380" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="p2-keys" value="Keys" style="swimlane;collapsible=0;fontStyle=1;startSize=32;fillColor=#EDF2F7;swimlaneFillColor=#FFFFFF;strokeColor=#4A5568;fontColor=#1A202C;fontSize=13;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="860" y="380" width="240" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p2-keys-body" value="PK  primary key&lt;br&gt;FK  foreign key&lt;br&gt;UK  unique&lt;br&gt;&lt;br&gt;users.roleId is required.&lt;br&gt;No user without a role." style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=12;fontColor=#1A202C;" parent="p2-keys" vertex="1">
                    <mxGeometry y="32" width="240" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="p2-note" value="Notes" style="swimlane;collapsible=0;fontStyle=1;startSize=32;fillColor=#EDF2F7;swimlaneFillColor=#FFFFFF;strokeColor=#4A5568;fontColor=#1A202C;fontSize=13;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="120" y="550" width="980" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p2-note-body" value="Many users can share one Role (many PLAYER rows). Each User points to exactly one Role.&lt;br&gt;The UI picks the role on create, so POST /users writes user + roleId together.&lt;br&gt;Role names are seed data. Users do not create new role names in Version 1.&lt;br&gt;Several roles on one user (PARENT + COACH) is out of scope for now." style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=12;fontColor=#1A202C;" parent="p2-note" vertex="1">
                    <mxGeometry y="32" width="980" height="78" as="geometry"/>
                </mxCell>
            </root>
