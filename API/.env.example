# Passwords and the JWT secret below are read from this file.
# The Spring profile is not. springboot4-dotenv loads .env after the profile
# is already chosen, so SPRING_PROFILES_ACTIVE here does nothing.
# Set it in the start command instead (see the README). Example: dev
DB_PASSWORD=
# At least 32 bytes, random. Example (PowerShell): [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=
# Temporary password for the bootstrap admin (only used when the admin does not exist yet, and by the dev demo seed).
BOOTSTRAP_ADMIN_PASSWORD=
# Optional, defaults to admin@fcvaxjo.se
BOOTSTRAP_ADMIN_EMAIL=
# Temporary password for all demo users (dev profile only). Empty = no demo data.
DEMO_PASSWORD=
# true = återställ admin- och demolösenord vid varje start (om du glömt ditt). Annars false.
DEMO_RESET_PASSWORDS=false
